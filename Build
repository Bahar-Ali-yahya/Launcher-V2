name: Build HyperLauncher APK

on:
  push:
    branches: [ "main" ]
  pull_request:
    branches: [ "main" ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout du dépôt
        uses: actions/checkout@v4

      # --- Localiser le projet -------------------------------------------------
      # Si un .zip du projet est présent à la racine du dépôt, on l'extrait.
      # Sinon on suppose que le code source est déjà commité directement.
      - name: Extraire le zip du projet (si présent)
        run: |
          ZIP=$(ls *.zip 2>/dev/null | head -1)
          if [ -n "$ZIP" ]; then
            echo "Zip trouvé : $ZIP"
            unzip -q "$ZIP" -d extracted
          fi

      - name: Localiser le dossier du projet Android
        id: locate
        run: |
          # 1) On cherche d'abord par nom (redmi / launcher / hyperlauncher)
          PROJ=$(find . extracted -maxdepth 2 -type d \( -iname "*redmi*" -o -iname "*hyperlauncher*" -o -iname "*launcher*" \) 2>/dev/null | head -1)
          # 2) Repli fiable : n'importe quel dossier contenant settings.gradle(.kts) = racine d'un projet Gradle valide
          if [ -z "$PROJ" ]; then
            SETTINGS=$(find . extracted -maxdepth 3 \( -name "settings.gradle" -o -name "settings.gradle.kts" \) 2>/dev/null | head -1)
            if [ -n "$SETTINGS" ]; then PROJ=$(dirname "$SETTINGS"); fi
          fi
          if [ -z "$PROJ" ]; then
            echo "::error::Impossible de localiser le projet Android (ni par nom, ni via settings.gradle)."
            exit 1
          fi
          echo "Projet trouvé : $PROJ"
          echo "project_dir=$PROJ" >> "$GITHUB_OUTPUT"

      # --- Environnement de build -----------------------------------------------
      - name: JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '17'

      - name: SDK Android
        uses: android-actions/setup-android@v3

      - name: Installer les composants SDK requis et accepter les licences
        run: |
          yes | sdkmanager --licenses > /dev/null || true
          sdkmanager "platform-tools" "platforms;android-35" "build-tools;36.0.0"

      - name: Générer le wrapper Gradle (version alignée avec AGP 9.3.0)
        working-directory: ${{ steps.locate.outputs.project_dir }}
        run: gradle wrapper --gradle-version 9.5.0

      - name: Autoriser l'exécution de gradlew
        working-directory: ${{ steps.locate.outputs.project_dir }}
        run: chmod +x gradlew

      # --- Build ------------------------------------------------------------
      - name: Build APK debug
        working-directory: ${{ steps.locate.outputs.project_dir }}
        run: ./gradlew assembleDebug --stacktrace

      - name: Décoder le keystore de signature (si configuré en secret)
        if: ${{ secrets.KEYSTORE_BASE64 != '' }}
        working-directory: ${{ steps.locate.outputs.project_dir }}
        run: echo "${{ secrets.KEYSTORE_BASE64 }}" | base64 -d > app/release.keystore

      - name: Build APK release (signé si le keystore est configuré, sinon non signé)
        working-directory: ${{ steps.locate.outputs.project_dir }}
        env:
          KEYSTORE_PASSWORD: ${{ secrets.KEYSTORE_PASSWORD }}
          KEY_ALIAS: ${{ secrets.KEY_ALIAS }}
          KEY_PASSWORD: ${{ secrets.KEY_PASSWORD }}
        run: ./gradlew assembleRelease --stacktrace

      # --- Livrables ----------------------------------------------------------
      - name: Préparer le paquet de sortie
        working-directory: ${{ steps.locate.outputs.project_dir }}
        run: |
          mkdir -p out_package
          find app/build/outputs/apk -name "*.apk" -exec cp {} out_package/ \;
          {
            echo "HyperLauncher V2 - APK compilés automatiquement par GitHub Actions."
            echo "Build : $(date -u +'%Y-%m-%d %H:%M UTC')"
            echo "Commit : ${{ github.sha }}"
          } > out_package/README.txt
          cd out_package && zip -r ../HyperLauncher_Release.zip .

      - name: Publier les APK (artifact debug + release)
        uses: actions/upload-artifact@v4
        with:
          name: HyperLauncher-APK
          path: ${{ steps.locate.outputs.project_dir }}/out_package/*.apk
          if-no-files-found: error

      - name: Publier le paquet complet (zip)
        uses: actions/upload-artifact@v4
        with:
          name: HyperLauncher_Release
          path: ${{ steps.locate.outputs.project_dir }}/HyperLauncher_Release.zip
