name: Build APK & ZIP Release

on:
  push:
    branches:
      - main
      - master
    tags:
      - 'v*.*.*'
  pull_request:
    branches:
      - main
      - master
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    name: Build APK & ZIP Package

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: List files in repository
        run: |
          echo "=== Files in repository ==="
          ls -la
          echo ""
          echo "=== Looking for ZIP files ==="
          find . -name "*.zip" -type f

      - name: Setup Java
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '11'
          cache: gradle

      - name: Setup Android SDK
        uses: android-actions/setup-android@v3

      - name: Extract and find project directory
        run: |
          # Find the ZIP file
          ZIP_FILE=$(find . -maxdepth 1 -name "*.zip" -type f | head -1)
          
          if [ -z "$ZIP_FILE" ]; then
            echo "❌ No ZIP file found in repository!"
            ls -la
            exit 1
          fi
          
          echo "✅ Found ZIP file: $ZIP_FILE"
          
          # Extract ZIP
          unzip -q "$ZIP_FILE"
          
          echo "✅ ZIP extracted successfully"
          echo ""
          echo "=== Contents after extraction ==="
          ls -la
          
          # Find the project directory
          PROJECT_DIR=$(find . -maxdepth 1 -type d \( -name "*Redmi*" -o -name "*Launcher*" -o -name "*redmi*" -o -name "*launcher*" \) 2>/dev/null | grep -v "^\.$" | head -1)
          
          if [ -z "$PROJECT_DIR" ]; then
            echo "❌ Could not find project directory"
            ls -la
            exit 1
          fi
          
          echo "✅ Found project directory: $PROJECT_DIR"
          echo "PROJECT_DIR=$PROJECT_DIR" >> $GITHUB_ENV

      - name: Make gradlew executable
        run: |
          chmod +x "${{ env.PROJECT_DIR }}/gradlew"
          echo "✅ gradlew is executable"

      - name: Build Release APK
        run: |
          cd "${{ env.PROJECT_DIR }}"
          echo "=== Building APK ==="
          ./gradlew assembleRelease --no-daemon
          echo "✅ APK built successfully"

      - name: Create ZIP package for Android
        run: |
          cd "${{ env.PROJECT_DIR }}"
          
          echo "=== Creating Android package ==="
          mkdir -p android-package
          
          # Copy APK
          cp app/build/outputs/apk/release/*.apk android-package/ 2>/dev/null || {
            echo "⚠️ No APK found in expected location, searching..."
            find . -name "*.apk" -type f | head -1 | xargs -I {} cp {} android-package/
          }
          
          # Create installation guide
          cat > android-package/INSTALL.txt << 'EOF'
╔════════════════════════════════════════════════╗
║  Redmi A5 HyperLauncher Installation Guide    ║
╚════════════════════════════════════════════════╝

1. METHODE D'INSTALLATION
   Option A: Installation directe du APK
   - Copiez le fichier .apk sur votre Redmi A5
   - Ouvrez le gestionnaire de fichiers et tapez sur le APK
   - Suivez les instructions d'installation

   Option B: Via ADB
   - Activez le débogage USB sur votre appareil
   - Connectez-vous au PC via USB
   - Exécutez: adb install -r *.apk

2. AUTORISATIONS
   L'application nécessite ces autorisations:
   - Accès au lanceur de l'appareil
   - Superposition système (pour les fenêtres flottantes)
   - Accès au stockage

3. PREMIER LANCEMENT
   - Ouvrez l'application à partir de votre tiroir d'applications
   - Accordez les autorisations demandées
   - Personnalisez les tuiles et la disposition

4. DEPANNAGE
   - Si l'installation échoue: activez "Sources inconnues"
   - Force à effacer les données de l'application
   - Vérifiez l'espace de stockage disponible (~50 Mo gratuit)

5. SUPPORT
   Visitez: https://github.com/Bahar-Ali-yahya/Launcher-V2
EOF
          
          # Create README
          cat > android-package/README.txt << 'EOF'
Redmi A5 HyperLauncher V2
==========================

Contenu:
- app-release.apk      : APK du lanceur principal
- INSTALL.txt          : Instructions d'installation
- README.txt           : Ce fichier

Exigences:
- Android 10+ (API 29+)
- ~50 Mo d'espace libre
- Compatible avec Redmi A5 et appareils similaires

Version: 2.0
EOF
          
          # Create final ZIP
          cd android-package
          zip -r ../HyperLauncher_Android_Package.zip *
          cd ..
          
          echo "✅ Android package created successfully"
          ls -lh HyperLauncher_Android_Package.zip

      - name: List build outputs
        if: always()
        run: |
          echo "=== Build Outputs ==="
          ls -lh "${{ env.PROJECT_DIR }}/app/build/outputs/apk/release/" 2>/dev/null || echo "No APK directory found"
          echo ""
          echo "=== ZIP Package ==="
          ls -lh "${{ env.PROJECT_DIR }}/HyperLauncher_Android_Package.zip" 2>/dev/null || echo "No ZIP package found"

      - name: Upload APK artifact
        uses: actions/upload-artifact@v4
        with:
          name: APK-Release
          path: "${{ env.PROJECT_DIR }}/app/build/outputs/apk/release/*.apk"
          retention-days: 30

      - name: Upload ZIP artifact
        uses: actions/upload-artifact@v4
        with:
          name: Android-Package-ZIP
          path: "${{ env.PROJECT_DIR }}/HyperLauncher_Android_Package.zip"
          retention-days: 30

      - name: Create GitHub Release (on tag push)
        if: startsWith(github.ref, 'refs/tags/')
        uses: softprops/action-gh-release@v1
        with:
          files: |
            ${{ env.PROJECT_DIR }}/app/build/outputs/apk/release/*.apk
            ${{ env.PROJECT_DIR }}/HyperLauncher_Android_Package.zip
          draft: false
          prerelease: false
          generate_release_notes: true
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

      - name: Comment on pull request with status
        if: github.event_name == 'pull_request'
        uses: actions/github-script@v7
        with:
          script: |
            const fs = require('fs');
            const projectDir = process.env.PROJECT_DIR;
            const apkPath = `${projectDir}/app/build/outputs/apk/release/app-release.apk`;
            const zipPath = `${projectDir}/HyperLauncher_Android_Package.zip`;
            
            let comment = '## ✅ Build Status\n\n';
            
            if (fs.existsSync(apkPath)) {
              const apkSize = fs.statSync(apkPath).size / (1024 * 1024);
              comment += `✅ APK built successfully (${apkSize.toFixed(2)} MB)\n`;
            } else {
              comment += '❌ APK build failed\n';
            }
            
            if (fs.existsSync(zipPath)) {
              const zipSize = fs.statSync(zipPath).size / (1024 * 1024);
              comment += `✅ Android package created (${zipSize.toFixed(2)} MB)\n`;
            } else {
              comment += '❌ Android package creation failed\n';
            }
            
            comment += '\n**Artifacts are available in the workflow run details** 📦';
            
            github.rest.issues.createComment({
              issue_number: context.issue.number,
              owner: context.repo.owner,
              repo: context.repo.repo,
              body: comment
            });
